<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@color/app_background">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_lessthan"
            app:tint="@color/primary_color" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Batch 1 Details"
            android:textColor="@color/primary_color"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_more"
            app:tint="@color/primary_color" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Summary Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivPlant"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/lettuce"
                            app:shapeAppearanceOverlay="@style/RoundedCornerImage" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/ivPlant"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:id="@+id/tvBatchName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Batch 1"
                                    android:textColor="@color/app_text"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:background="@drawable/badge_bg"
                                    android:paddingHorizontal="12dp"
                                    android:paddingVertical="4dp"
                                    android:text="Completed ✓"
                                    android:textColor="@color/recommendation_text"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </RelativeLayout>

                            <TextView
                                android:id="@+id/tvPlantType"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Lettuce (Romaine)"
                                android:textColor="@color/text_color"
                                android:textSize="14sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/history"
                                    app:tint="#5E5F60" />

                                <TextView
                                    android:id="@+id/tvDateRange"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="May 14 - Jun 15, 2026 (32 days)"
                                    android:textColor="@color/text_color"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:background="@color/divider_color" />

                    <!-- Stats Grid 3x3 -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="3"
                        android:rowCount="3">

                        <!-- Avg Growth -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Avg Growth" android:textColor="#9E9E9E" android:textSize="11sp" />
                            <TextView android:id="@+id/tvAvgGrowth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="25.3 cm" android:textColor="@color/recommendation_text" android:textSize="15sp" android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Water Used -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Water Used" android:textColor="#9E9E9E" android:textSize="11sp" />
                            <TextView android:id="@+id/tvWaterUsed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="38 L" android:textColor="@color/recommendation_text" android:textSize="15sp" android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Avg Temp (Air) -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Avg Temp" android:textColor="#9E9E9E" android:textSize="11sp" />
                            <TextView android:id="@+id/tvAvgTemp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="27.2 °C" android:textColor="@color/app_text" android:textSize="15sp" android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Avg pH -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Avg pH" android:textColor="#9E9E9E" android:textSize="11sp" />
                            <TextView android:id="@+id/tvAvgPh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="6.1" android:textColor="@color/app_text" android:textSize="15sp" android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Avg Humidity -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Avg Humidity" android:textColor="#9E9E9E" android:textSize="11sp" />
                            <TextView android:id="@+id/tvAvgHumidity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="72%" android:textColor="@color/app_text" android:textSize="15sp" android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Avg TDS -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Avg TDS" android:textColor="#9E9E9E" android:textSize="11sp" />
                            <TextView android:id="@+id/tvAvgTds" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="850 ppm" android:textColor="@color/app_text" android:textSize="15sp" android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Water Temp -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Water Temp" android:textColor="#9E9E9E" android:textSize="11sp" />
                            <TextView android:id="@+id/tvWaterTemp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="24.5 °C" android:textColor="@color/app_text" android:textSize="15sp" android:textStyle="bold" />
                        </LinearLayout>
                    </GridLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Tabs -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@android:color/transparent"
                app:tabIndicatorColor="@color/primary_color"
                app:tabSelectedTextColor="@color/primary_color"
                app:tabTextColor="@color/text_color"
                app:tabRippleColor="@null"
                app:tabMode="fixed">
                <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trends" />
                <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Photos" />
                <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Notes" />
                <com.google.android.material.tabs.TabItem android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Summary" />
            </com.google.android.material.tabs.TabLayout>

            <!-- Range Filter -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">
                <Button android:layout_width="wrap_content" android:layout_height="36dp" android:text="7 Days" android:textSize="12sp" android:backgroundTint="@color/button_background_inactive" android:textColor="@color/text_color" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:layout_marginEnd="4dp" />
                <Button android:layout_width="wrap_content" android:layout_height="36dp" android:text="14 Days" android:textSize="12sp" android:backgroundTint="@color/button_background_inactive" android:textColor="@color/text_color" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:layout_marginEnd="4dp" />
                <Button android:layout_width="wrap_content" android:layout_height="36dp" android:text="30 Days" android:textSize="12sp" android:backgroundTint="@color/primary_color" android:textColor="@color/white" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" android:layout_marginEnd="4dp" />
                <Button android:layout_width="wrap_content" android:layout_height="36dp" android:text="All" android:textSize="12sp" android:backgroundTint="@color/button_background_inactive" android:textColor="@color/text_color" style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />
            </LinearLayout>

            <!-- Temperature Chart -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/card_background">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Temperature (°C)" android:textColor="#E67E22" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="Avg 27.2 °C" android:textColor="@color/app_text" android:textSize="12sp" />
                    </RelativeLayout>
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/tempChart"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- pH Level Chart -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/card_background">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="pH Level" android:textColor="#3498DB" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="Avg 6.1" android:textColor="@color/app_text" android:textSize="12sp" />
                    </RelativeLayout>
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/phChart"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Humidity Chart -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/card_background">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Humidity (%)" android:textColor="#27AE60" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="Avg 72%" android:textColor="@color/app_text" android:textSize="12sp" />
                    </RelativeLayout>
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/humidityChart"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Growth Chart -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/card_background">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Growth (cm)" android:textColor="#9B59B6" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="Final 25.3 cm" android:textColor="@color/app_text" android:textSize="12sp" />
                    </RelativeLayout>
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/growthChart"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Notes Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/card_background">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Notes" android:textColor="@color/app_text" android:textSize="16sp" android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="• Changed nutrient solution on May 28.\n• Plants looked healthy throughout the cycle."
                        android:textColor="@color/text_color"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
