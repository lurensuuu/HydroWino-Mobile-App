<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".DevicesFragment">

    <ScrollView
        android:id="@+id/devicesContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="25dp"
                android:layout_marginTop="90dp"
                android:layout_marginEnd="25dp">

                <TextView
                    android:id="@+id/tvHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mga_device"
                    android:textColor="@color/app_text"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="3dp"
                    android:background="@color/primary_color"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/devices_desc"
                    android:textSize="14sp"
                    android:textColor="@color/text_color"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- Water Pump Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/water_pump"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/app_text"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/water_pump_desc"
                            android:textSize="14sp"
                            android:textColor="@color/text_color"
                            android:layout_marginTop="2dp"/>

                        <LinearLayout
                            android:id="@+id/statusWaterPump"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/status_badge_bg"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="12dp"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp">
                            <View
                                android:id="@+id/dotWaterPump"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/ic_dot_green"/>
                            <TextView
                                android:id="@+id/tvStatusWaterPump"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/status_offline"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#1E8449"
                                android:layout_marginStart="6dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:id="@+id/tvSwitchLabelWaterPump"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/device_inactive"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/app_text"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Solution A -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/solution_a"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/app_text"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/solution_a_desc"
                            android:textSize="14sp"
                            android:textColor="@color/text_color"
                            android:layout_marginTop="2dp"/>

                        <LinearLayout
                            android:id="@+id/statusSolutionA"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/status_badge_bg"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="12dp"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp">
                            <View
                                android:id="@+id/dotSolutionA"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/ic_dot_green"/>
                            <TextView
                                android:id="@+id/tvStatusSolutionA"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/status_offline"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#1E8449"
                                android:layout_marginStart="6dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:id="@+id/tvSwitchLabelSolutionA"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/device_inactive"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/app_text"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Solution B -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/solution_b"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/app_text"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/solution_b_desc"
                            android:textSize="14sp"
                            android:textColor="@color/text_color"
                            android:layout_marginTop="2dp"/>

                        <LinearLayout
                            android:id="@+id/statusSolutionB"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/status_badge_bg"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="12dp"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp">
                            <View
                                android:id="@+id/dotSolutionB"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/ic_dot_green"/>
                            <TextView
                                android:id="@+id/tvStatusSolutionB"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/status_offline"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#1E8449"
                                android:layout_marginStart="6dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:id="@+id/tvSwitchLabelSolutionB"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/device_inactive"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/app_text"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Solution C -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/solution_c"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/app_text"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/solution_c_desc"
                            android:textSize="14sp"
                            android:textColor="@color/text_color"
                            android:layout_marginTop="2dp"/>

                        <LinearLayout
                            android:id="@+id/statusSolutionC"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/status_badge_bg"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="12dp"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp">
                            <View
                                android:id="@+id/dotSolutionC"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/ic_dot_green"/>
                            <TextView
                                android:id="@+id/tvStatusSolutionC"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/status_offline"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#1E8449"
                                android:layout_marginStart="6dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:id="@+id/tvSwitchLabelSolutionC"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/device_inactive"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/app_text"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Connection Status Banner -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardConnectionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/status_improved_bg">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="15dp">

                    <FrameLayout
                        android:id="@+id/iconContainer"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:layout_centerVertical="true"
                        android:background="@drawable/circle_bg"
                        android:backgroundTint="@color/white"
                        >

                        <ImageView
                            android:id="@+id/ivStatusIcon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/security32"
                             />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/iconContainer"
                        android:layout_toStartOf="@id/ivPlantIllustration"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvConnectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/all_devices_offline"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/status_improved_text" />

                        <TextView
                            android:id="@+id/tvConnectionDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/connect_system_prompt"
                            android:textSize="12sp"
                            android:textColor="@color/status_improved_text"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivPlantIllustration"
                        android:layout_width="70dp"
                        android:layout_height="50dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/lettuce64x"
                        android:scaleType="centerInside" />

                </RelativeLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/emptyStateLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="visible">

        <ImageView
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/greenhouse2"
            android:alpha="0.8"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="No greenhouse assigned"
            android:textColor="@color/app_text"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textAlignment="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Connect to a greenhouse to view and monitor your connected devices."
            android:textColor="#666666"
            android:textSize="14sp"
            android:textAlignment="center"/>

    </LinearLayout>

</FrameLayout>

