<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ConfirmationCode">

    <TextView android:id="@+id/textView1"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Enter confirmation code"
        android:textAlignment="center"
        android:textAllCaps="false"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/textView2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>

    <TextView
        android:id="@+id/textView2"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Enter the 4 digits code was sent to you email"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/otpContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView1"/>

    <LinearLayout
        android:id="@+id/otpContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/TimerText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2">

        <EditText
            android:id="@+id/otp1"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="8dp"
            android:background="@drawable/ic_otp_background"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="#0EBE7F"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/otp2"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="8dp"
            android:background="@drawable/ic_otp_background"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="#0EBE7F"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/otp3"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="8dp"
            android:background="@drawable/ic_otp_background"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="#0EBE7F"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/otp4"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="8dp"
            android:background="@drawable/ic_otp_background"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="#0EBE7F"
            android:textSize="24sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <TextView
        android:id="@+id/TimerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Code expires in: 300s"
        android:textColor="#757575"
        app:layout_constraintBottom_toTopOf="@+id/ResendButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/otpContainer" />

    <TextView
        android:id="@+id/ResendButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:text="Resend code"
        android:textColor="#0EBE7F"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/ContinueButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/TimerText"/>

    <Button
        android:id="@+id/ContinueButton"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        android:text="Continue"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@color/button"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ResendButton"/>

</androidx.constraintlayout.widget.ConstraintLayout>