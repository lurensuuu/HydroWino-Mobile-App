<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Green Ring -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="3dp"
                android:color="#00AA5B" />
            <size
                android:width="70dp"
                android:height="70dp" />
        </shape>
    </item>
    <!-- Inner White Circle -->
    <item
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp">
        <shape android:shape="oval">
            <solid android:color="@color/white" />
        </shape>
    </item>
</layer-list>