<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/hydrowino_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/hydrowino_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.HydroWino"
        tools:targetApi="31">
        <service
            android:name=".SensorMonitoringService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name=".ConnectGreenhouseActivity"
            android:exported="false" />
        <activity
            android:name=".GreenhouseActivity"
            android:exported="false" />
        <activity
            android:name=".PendingApprovalActivity"
            android:exported="false" />
        <activity
            android:name=".NotificationsActivity"
            android:exported="false" />

        <activity
            android:name=".PlantHistoryActivity"
            android:exported="false" />

        <activity
            android:name=".BatchDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".GrowthDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".display"
            android:exported="false" />
        <activity
            android:name=".changePass"
            android:exported="false" />
        <activity
            android:name=".change_email"
            android:exported="false" />
        <activity
            android:name=".PasswordandSecurity"
            android:exported="false" />
        <activity
            android:name=".Language"
            android:exported="false" />
        <activity
            android:name=".forgotPass"
            android:exported="false"
            tools:ignore="Instantiatable" />
        <activity
            android:name=".ConfirmationCode"
            android:exported="false" />
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".loginActivity"
            android:exported="true" />
        <activity android:name=".MainActivity" />
        <activity
            android:name=".CameraActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
        <activity
            android:name=".ResultActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
        <activity
            android:name=".TreatmentActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
    </application>

</manifest>
